{
  "name": "arca-rh",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "generate": "node scripts/prisma.mjs generate",
    "migrate": "node scripts/prisma.mjs migrate deploy",
    "check": "tsc --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "bootstrap": "node --env-file=.env scripts/local-bootstrap.mjs",
    "demo:seed": "node --env-file=.env scripts/demo-local.mjs seed && node --env-file=.env scripts/demo-flows.mjs seed && node --env-file=.env scripts/demo-history.mjs && node scripts/demo-refresh-drafts.mjs",
    "demo:verify": "node --env-file=.env scripts/demo-local.mjs verify && node --env-file=.env scripts/demo-flows.mjs verify",
    "demo:reset": "node --env-file=.env scripts/demo-reset.mjs",
    "test": "node --env-file=.env tests/integration.mjs",
    "test:hu16": "node --import tsx tests/hu16-vacation-request.spec.ts",
    "test:hu17": "node --import tsx tests/hu17-vacation-decision.spec.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/swagger": "11.2.6",
    "@prisma/client": "6.19.3",
    "argon2": "0.44.0",
    "cookie-parser": "1.4.7",
    "helmet": "8.1.0",
    "jose": "6.1.0",
    "nodemailer": "10.3.1",
    "pdfkit": "0.17.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.5",
    "@types/node": "24.10.0",
    "@types/nodemailer": "7.0.3",
    "@types/pdfkit": "0.17.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "prisma": "6.19.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.2.2"
  }
}
